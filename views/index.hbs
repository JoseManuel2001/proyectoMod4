<!DOCTYPE html>
<html lang="es">

<head>
    <title>{{title}}</title>
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

</head>

<body>
    <div class="main-layout">
        {{> lateralLayout}}
    </div>
    <div class="main-page">
        <div class="heder-top-information">
            <div class="main-content">
                {{> header}}

            </div>
            <div class="header-review">

            </div>
        </div>

        <div class="page-inicio-container">

    <section class="weather-search-section">
        <div class="weather-search-header">
            <span class="weather-search-icon">
                <i class="fa-solid fa-location-dot"></i>
            </span>

            <div>
                <h2>Consulta el clima</h2>
                <p>Ingresa una ciudad para conocer sus condiciones actuales.</p>
            </div>
        </div>

        <form action="/weather" method="GET" class="weather-form">
            <div class="weather-input-container">
                <i class="fa-solid fa-magnifying-glass"></i>

                <input
                    type="text"
                    name="city"
                    placeholder="Ejemplo: Toluca, México"
                    autocomplete="off"
                    required
                >
            </div>

            <button type="submit">
                <i class="fa-solid fa-cloud-sun"></i>
                Buscar clima
            </button>
        </form>
    </section>

    {{#if weather}}
        <section class="weather-card">
            <div class="weather-card-header">
                <div>
                    <span class="weather-card-label">Clima actual</span>
                    <h2>{{weather.ciudad}}, {{weather.pais}}</h2>
                    <p>{{weather.descripcion}}</p>
                </div>

                <div class="weather-icon-container">
                    <img
                        src="{{weather.icono}}"
                        alt="Icono del clima en {{weather.ciudad}}"
                    >
                </div>
            </div>

            <div class="weather-temperature">
                <span>{{weather.temperatura}}</span>
                <small>°C</small>
            </div>

            <div class="weather-details">
                <article class="weather-detail">
                    <div class="weather-detail-icon">
                        <i class="fa-solid fa-temperature-half"></i>
                    </div>

                    <div>
                        <span>Sensación</span>
                        <strong>{{weather.sensacion}} °C</strong>
                    </div>
                </article>

                <article class="weather-detail">
                    <div class="weather-detail-icon">
                        <i class="fa-solid fa-droplet"></i>
                    </div>

                    <div>
                        <span>Humedad</span>
                        <strong>{{weather.humedad}}%</strong>
                    </div>
                </article>

                <article class="weather-detail">
                    <div class="weather-detail-icon">
                        <i class="fa-solid fa-wind"></i>
                    </div>

                    <div>
                        <span>Viento</span>
                        <strong>{{weather.viento}} km/h</strong>
                    </div>
                </article>

                <article class="weather-detail">
                    <div class="weather-detail-icon">
                        <i class="fa-solid fa-sun"></i>
                    </div>

                    <div>
                        <span>Astro</span>
                        <strong>{{weather.astro}}</strong>
                    </div>
                </article>
            </div>
        </section>
    {{/if}}

    {{#if error}}
        <div class="weather-alert">
            <i class="fa-solid fa-circle-exclamation"></i>

            <div>
                <strong>No fue posible consultar el clima</strong>
                <p>{{error}}</p>
            </div>
        </div>
    {{/if}}

</div>
    </div>
</body>

</html>